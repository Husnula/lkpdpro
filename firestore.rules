rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdminEmail() {
      return request.auth.token.email == 'jagofeed@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() 
        && (
          request.auth.token.email == 'jagofeed@gmail.com' ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super-admin'
            )
          )
        );
    }

    function isActive() {
      return isSignedIn()
        && (
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
          )
        );
    }

    function isValidUser(data) {
      let requiredFields = ['email', 'role', 'status']; // Minimum required for skeleton
      return data.keys().hasAll(requiredFields)
        && data.email is string && data.email.size() <= 256
        && (data.role in ['user', 'agency', 'admin', 'super-admin'])
        && (data.status in ['pending', 'active', 'suspended', 'rejected'])
        && (!('uid' in data) || data.uid == null || data.uid is string)
        && (!('lastLogin' in data) || data.lastLogin == null || data.lastLogin is timestamp)
        && (!('licenseStatus' in data) || data.licenseStatus in ['none', 'unlimited', 'capped'])
        && (!('userQuota' in data) || data.userQuota is int)
        && (!('usageCount' in data) || data.usageCount is int)
        && (!('purchaseDate' in data) || (data.purchaseDate is string || data.purchaseDate == null))
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 256))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024));
    }

    function isValidLKPD(data) {
      let requiredFields = ['userId', 'title', 'step', 'formData', 'outline', 'pageData', 'updatedAt'];
      return data.keys().hasAll(requiredFields)
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 400
        && data.step is int
        && data.formData is map
        && data.outline is string && data.outline.size() <= 500000
        && data.pageData is string && data.pageData.size() <= 1000000
        && data.updatedAt == request.time;
    }

    // Pillar 1: Master Gate
    match /test/connection {
      allow get: if isSignedIn();
    }

    function isAgencyEmail() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agency';
    }

    match /users/{userId} {
      // Allow users to find their skeleton document (invited by agency) by email query
      // Allow agencies to query their own team (by agencyId) OR search someone by email
      allow list: if isAdmin() 
        || (isSignedIn() && resource.data.agencyId == request.auth.uid)
        || (isSignedIn() && resource.data.email != null 
            && resource.data.email.lower() == request.auth.token.email.lower());
      
      // Allow read if owner, admin, assigned agency, or matching email (for skeleton)
      allow read: if isOwner(userId) || isAdmin() || (isSignedIn() && (
        resource.data.email.lower() == request.auth.token.email.lower() ||
        resource.data.agencyId == request.auth.uid
      ));
      
      allow create: if (
        // Case 1: Super Admin Self-registration bootstrap/owner (using UID as document ID)
        (isOwner(userId) 
          && isValidId(userId) 
          && isValidUser(incoming())
          && incoming().uid == request.auth.uid
          && request.auth.token.email == 'jagofeed@gmail.com'
          && incoming().role == 'super-admin'
          && incoming().status == 'active'
        ) ||
        // Case 2: Agency creating skeleton user (random document ID)
        (isSignedIn() 
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && isAgencyEmail()
          && incoming().agencyId == request.auth.uid
          && (incoming().role == 'user' || incoming().role == 'agency')
          && incoming().status == 'active'
          && isValidUser(incoming())
          && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.licenseStatus == 'unlimited' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.usageCount < get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userQuota
          )
        ) ||
        // Case 3: User migrating skeleton data to their own UID-based document
        (isOwner(userId) 
          && isValidUser(incoming()) 
          && incoming().uid == request.auth.uid
          && incoming().email.lower() == request.auth.token.email.lower()
          && incoming().status == 'active'
        ) ||
        // Case 4: Admin creating any user/skeleton
        (isAdmin() && isValidUser(incoming()))
      );
        
      allow update: if isValidId(userId) && (
        (isOwner(userId) && isValidUser(incoming())
          && (
            // Profile Update (Self)
            (incoming().diff(existing()).affectedKeys().hasOnly(['lastLogin', 'displayName', 'photoURL']) && incoming().role == existing().role && incoming().status == existing().status) ||
            // Migration Support: Owner sets agencyId, role 'user', and status 'active' when linking to a valid agency doc0
            (incoming().diff(existing()).affectedKeys().hasOnly(['lastLogin', 'displayName', 'photoURL', 'agencyId', 'status', 'role'])
              && incoming().status == 'active'
              && incoming().role == 'user'
              && ('agencyId' in incoming()) && incoming().agencyId != null
              && get(/databases/$(database)/documents/users/$(incoming().agencyId)).data.role == 'agency'
            ) ||
            // Agency/Admin self-maintenance or usage increment (restricted only to agencies with exact increment)
            (incoming().diff(existing()).affectedKeys().hasOnly(['usageCount']) 
              && existing().role == 'agency' 
              && (incoming().usageCount == existing().usageCount + 1 || incoming().usageCount == existing().usageCount - 1)
            ) ||
            (isAdminEmail() && incoming().role == 'super-admin' && incoming().status == 'active')
          )
        ) ||
        (isSignedIn() 
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && isAgencyEmail()
          && isValidUser(incoming())
          && (
            // Action 1: Add to team (Updating another user)
            // Can only add if the user doesn't already have an agency
            (
              (!('agencyId' in existing()) || existing().agencyId == null) &&
              incoming().agencyId == request.auth.uid &&
              incoming().role == 'user' &&
              incoming().status == 'active' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['agencyId', 'role', 'status'])
            ) ||
            // Action 2: Remove from team (Setting agencyId to null)
            (
              existing().agencyId == request.auth.uid &&
              (!('agencyId' in incoming()) || incoming().agencyId == null) &&
              incoming().status == 'pending' &&
              incoming().diff(existing()).affectedKeys().hasOnly(['agencyId', 'status'])
            )
          )
        ) || 
        // Admin can update everything (role, license, quota, status)
        (isAdmin() && isValidUser(incoming()))
      );

      // Allow user themselves, admin, or assigned agency (to delete skeleton)
      allow delete: if isAdmin() 
        || (isSignedIn() && existing().email == request.auth.token.email)
        || (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && isAgencyEmail() && existing().agencyId == request.auth.uid);
    }

    match /lkpds/{lkpdId} {
      allow list: if (isActive() || isAdminEmail()) && resource.data.userId == request.auth.uid && request.query.limit <= 50;
      allow get: if (isActive() || isAdminEmail()) && isValidId(lkpdId) && existing().userId == request.auth.uid;
      
      allow create: if (isActive() || isAdminEmail())
        && isValidId(lkpdId) 
        && isValidLKPD(incoming())
        && incoming().createdAt == request.time
        && incoming().keys().size() >= 8 && incoming().keys().size() <= 10;
        
      allow update: if (isActive() || isAdminEmail()) && isValidId(lkpdId) && existing().userId == request.auth.uid 
        && isValidLKPD(incoming())
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'title', 'step', 'formData', 'outline', 'pageData', 'updatedAt', 'referensiProyek']);
        
      allow delete: if (isActive() || isAdminEmail()) && isValidId(lkpdId) && existing().userId == request.auth.uid;
    }
  }
}
