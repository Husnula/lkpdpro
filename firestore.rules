rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdminEmail() {
      return request.auth.token.email == 'jagofeed@gmail.com' && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() 
        && request.auth.token.email_verified == true 
        && (
          request.auth.token.email == 'jagofeed@gmail.com' ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
          )
        );
    }

    function isActive() {
      return isSignedIn()
        && (
          isAdmin() ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active'
          )
        );
    }

    function isValidUser(data) {
      let requiredFields = ['uid', 'email', 'role', 'status', 'lastLogin'];
      return data.keys().hasAll(requiredFields)
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (data.role in ['user', 'admin'])
        && (data.status in ['pending', 'active', 'suspended'])
        && data.lastLogin == request.time
        && (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 256))
        && (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1024));
    }

    function isValidLKPD(data) {
      let requiredFields = ['userId', 'title', 'step', 'formData', 'outline', 'pageData', 'updatedAt'];
      return data.keys().hasAll(requiredFields)
        && data.userId == request.auth.uid
        && data.title is string && data.title.size() <= 200
        && data.step is int
        && data.formData is map
        && data.outline is string && data.outline.size() <= 100000
        && data.pageData is map
        && data.updatedAt == request.time;
    }

    // Pillar 1: Master Gate
    match /test/connection {
      allow get: if isSignedIn();
    }

    match /users/{userId} {
      allow list: if isAdmin();
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      
      allow create: if isOwner(userId) 
        && isValidId(userId) 
        && isValidUser(incoming())
        && incoming().keys().size() >= 5 && incoming().keys().size() <= 7
        && (
          (isAdminEmail() && incoming().role == 'admin' && incoming().status == 'active') ||
          (!isAdminEmail() && incoming().role == 'user' && incoming().status == 'pending')
        );
        
      allow update: if isValidId(userId) && (
        (isOwner(userId) && isValidUser(incoming())
          && (
            // Action: Profile Update (Self)
            (incoming().diff(existing()).affectedKeys().hasOnly(['lastLogin', 'displayName', 'photoURL']) && incoming().role == existing().role && incoming().status == existing().status) ||
            // Action: Admin Bootstrap (Self)
            (isAdminEmail() && incoming().role == 'admin' && incoming().status == 'active')
          )
        )
        || (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'role']))
      );
    }

    match /lkpds/{lkpdId} {
      allow list: if isActive() && resource.data.userId == request.auth.uid;
      allow get: if isActive() && isValidId(lkpdId) && existing().userId == request.auth.uid;
      
      allow create: if isActive() 
        && isValidId(lkpdId) 
        && isValidLKPD(incoming())
        && incoming().createdAt == request.time
        && incoming().keys().size() == 8;
        
      allow update: if isActive() && isValidId(lkpdId) && existing().userId == request.auth.uid 
        && isValidLKPD(incoming())
        && incoming().userId == existing().userId
        && incoming().diff(existing()).affectedKeys().hasOnly(['userId', 'title', 'step', 'formData', 'outline', 'pageData', 'updatedAt']);
        
      allow delete: if isActive() && isValidId(lkpdId) && existing().userId == request.auth.uid;
    }
  }
}
